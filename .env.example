# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google AI Studio → Get API key. Server-only: never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Daily request ceiling the Settings screen counts against. Google changes free
# tier limits, and the API never reports what is left, so read the real number
# from your own project: AI Studio, or Cloud Console → Generative Language API
# → Quotas. Optional; defaults to 500.
GEMINI_DAILY_LIMIT=500

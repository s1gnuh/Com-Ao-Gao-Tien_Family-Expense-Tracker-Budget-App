# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google AI Studio → Get API key. Server-only: never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Daily request ceiling the Settings screen counts against. Google changes free
# tier limits, and the API never reports what is left, so read the real number
# from your own project: AI Studio, or Cloud Console → Generative Language API
# → Quotas. Optional; defaults to 500.
GEMINI_DAILY_LIMIT=500

# Supabase → Project Settings → API → service_role key. Bypasses RLS, used only
# by the cron route that reminds the whole household — never expose this to the
# browser, and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Generate with: npx web-push generate-vapid-keys
# The public key is safe in the browser (that's its job); the private key is
# server-only, same rule as GEMINI_API_KEY.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Required by the Web Push spec so a push service can contact you if something
# goes wrong. A mailto: address or an https:// URL both work.
VAPID_SUBJECT=mailto:you@example.com

# A random string only you and Vercel's scheduler know, so the reminder cron
# route can't be triggered by anyone who finds the URL. Generate with e.g.
# `openssl rand -hex 32`. Vercel sends it automatically as a Bearer token to
# every Cron Job once this env var exists — nothing else to configure.
CRON_SECRET=your-random-secret
